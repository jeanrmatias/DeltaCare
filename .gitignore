# Bytecode do Python — gerado automaticamente, nunca deve ir para o repositório
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais
venv/
.venv/
env/

# Banco de dados local.
# Os dados de demonstração são recriados pelo script de seed, então o .db não
# precisa (nem deve) ser versionado: é binário, gera conflito a cada execução e
# guarda hash de senha das contas de teste.
*.db
*.db-journal
# O banco esta em modo WAL (ver infra/database.py): ele mantem dois
# arquivos ao lado do .db enquanto ha conexao aberta.
*.db-wal
*.db-shm

# Arquivos enviados pelos professores (PDFs dos materiais).
# Em produção isso vai para storage em nuvem; em desenvolvimento fica só local.
# Sem prefixo de pasta de propósito: o caminho de upload é relativo ao diretório
# de onde o backend foi iniciado, então rodar o seed da raiz cria `uploads/` na
# raiz, e rodar de dentro de backend/ cria `backend/uploads/`. As duas ficam fora.
uploads/
# Cópias de segurança (backend/scripts/backup.py): têm dado de aluno e não vão para o
# repositório.
backups/

# Variáveis de ambiente / segredos (OLLAMA_URL, chaves de API no futuro)
.env
.env.local

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.swp

# Arquivos gerados a partir do codigo: o .zip da entrega, o PDF do documento
# e a concatenacao do fonte. Todos sao recriaveis e nenhum rende diff.
SPRINT_3.pdf
CODIGO_COMPLETO.md
DeltaCare_Sprint3_WebDevelopment.zip
