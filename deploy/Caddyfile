# Caddy na frente do Delta Care: HTTPS automático (certificado Let's Encrypt,
# renovado sozinho). Troque o domínio pelo da instituição.
deltacare.instituicao.edu.br {
	encode gzip

	# Arquivo de até 15MB chega em base64 dentro do JSON (~20MB), mais folga.
	request_body {
		max_size 25MB
	}

	# O resto dos cabeçalhos de segurança (Content-Security-Policy,
	# X-Frame-Options, nosniff...) vem da própria API: infra/cabecalhos.py.
	# Aqui só o que depende de HTTPS.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy 127.0.0.1:8000
}
