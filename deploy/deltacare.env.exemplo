# Configuração do Delta Care em produção.
# Copie para /etc/deltacare.env, preencha e proteja: chmod 600 (tem senha).

# --- Onde ficam os dados (fora da pasta do código, para atualizar sem medo) ---
DELTACARE_DB=/var/lib/deltacare/deltacare.db
DELTACARE_UPLOADS=/var/lib/deltacare/uploads
DELTACARE_BACKUPS=/var/lib/deltacare/backups
DELTACARE_BACKUPS_MANTER=14

# --- E-mail (recuperação de senha). Sem isto, o código só aparece no log. ---
DELTACARE_SMTP_HOST=smtp.instituicao.edu.br
DELTACARE_SMTP_PORTA=587
DELTACARE_SMTP_SEGURANCA=starttls
DELTACARE_SMTP_USUARIO=nao-responda@instituicao.edu.br
DELTACARE_SMTP_SENHA=
DELTACARE_SMTP_REMETENTE=Delta Care <nao-responda@instituicao.edu.br>

# --- Servidor do modelo de IA ---
OLLAMA_URL=http://127.0.0.1:11434
MODELO_CHAT=gpt-oss:20b
MODELO_EMBEDDING=nomic-embed-text
# Quantas chamadas vão ao modelo ao mesmo tempo. Não é limite de perguntas:
# quem passa disso espera sem travar o resto do sistema. Suba conforme a GPU.
DELTACARE_IA_SIMULTANEAS=4

# --- Navegador ---
# Com as telas servidas pela própria API (em /app/), tela e API têm a mesma
# origem e isto não é usado. Só preencha se a API ficar em outro domínio.
# DELTACARE_ORIGENS=https://deltacare.instituicao.edu.br
